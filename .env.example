# VisionGuard Lite Configuration Template
# Copy to .env and configure as appropriate for your local environment

# Server Binding
HOST=127.0.0.1
PORT=7860

# Model Paths (default: auto-detected relative to repo root)
MODEL_CHECKPOINT=checkpoints/temporal_cnn_best.pt
MEDIAPIPE_MODEL=checkpoints/pose_landmarker_lite.task
ONNX_MODEL=exported_models/temporal_cnn_clean.onnx

# Inference Defaults
DEFAULT_BACKEND=onnx
CONFIRMATION_WINDOWS=2
CONFIDENCE_THRESHOLD=0.70
UNCERTAINTY_THRESHOLD=0.35

# Optional Gated Dataset Access
HF_TOKEN=
